generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// NextAuth.js required tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSignedIn  DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  analyses         Analysis[]
  reports          Report[]
  adminLayers      AdminLayer[]
  aiConversations  AiConversation[]
}

enum Role {
  USER
  ADMIN
}

model Analysis {
  id              Int       @id @default(autoincrement())
  userId          String?
  fileName        String
  fileFormat      String
  fileSize        BigInt?
  status          Status    @default(PENDING)
  totalFeatures   Int       @default(0)
  errorCount      Int       @default(0)
  conformityScore Decimal   @default(0) @db.Decimal(5, 2)
  totalSurface    Decimal   @default(0) @db.Decimal(20, 4)
  crs             String?
  commune         String?
  region          String?
  geojsonKey      String?
  geojsonUrl      String?
  summaryStats    Json?
  geoJsonData     String?   @db.Text
  adminBoundaryData String? @db.Text
  errorsData      String?   @db.Text
  correctedData   String?   @db.Text
  aiReport        String?   @db.Text
  processingTime  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user              User?             @relation(fields: [userId], references: [id])
  topologicalErrors TopologicalError[]
  reports           Report[]
  overlapGeometries OverlapGeometry[]
  geoEngineResults  GeoEngineResult[]
  geoprocessingOps  GeoprocessingOp[]
  aiConversations   AiConversation[]
}

enum Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TopologicalError {
  id                 Int        @id @default(autoincrement())
  analysisId         Int
  errorType          ErrorType
  severity           Severity
  nicad1             String?
  nicad2             String?
  description        String?    @db.Text
  geometry           Json?
  area               Decimal?   @db.Decimal(20, 4)
  confidence         Decimal    @default(1.0000) @db.Decimal(5, 4)
  corrected          Boolean    @default(false)
  correctionGeometry Json?
  createdAt          DateTime   @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

enum ErrorType {
  OVERLAP
  GAP
  SLIVER
  DUPLICATE
  INVALID_GEOM
  BOUNDARY_CROSS
  MISSING_NICAD
  SHORT_NICAD
  SELF_INTERSECT
  SECTION_MISMATCH
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Report {
  id          Int        @id @default(autoincrement())
  analysisId  Int
  userId      String?
  reportType  ReportType @default(SUMMARY)
  title       String?
  content     String?    @db.Text
  pdfKey      String?
  pdfUrl      String?
  createdAt   DateTime   @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])
}

enum ReportType {
  SUMMARY
  DETAILED
  EXPERT
  CORRECTION
}

model AdminLayer {
  id          Int           @id @default(autoincrement())
  name        String
  layerType   AdminLayerType
  source      String?
  geojsonData String?       @db.Text
  geojsonKey  String?
  geojsonUrl  String?
  uploadedBy  String?
  createdAt   DateTime      @default(now())

  user User? @relation(fields: [uploadedBy], references: [id])
}

enum AdminLayerType {
  COMMUNE
  DEPARTEMENT
  REGION
  SECTION
  ILOT
}

model OverlapGeometry {
  id                    Int      @id @default(autoincrement())
  analysisId            Int
  nicad1                String?
  nicad2                String?
  intersectionGeometry  Json
  overlapAreaM2         Decimal? @db.Decimal(20, 4)
  overlapPercent        Decimal? @db.Decimal(8, 4)
  area1M2               Decimal? @db.Decimal(20, 4)
  area2M2               Decimal? @db.Decimal(20, 4)
  severity              Decimal? @db.Decimal(5, 4)
  featureIndex1         Int?
  featureIndex2         Int?
  createdAt             DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model GeoEngineResult {
  id                 Int      @id @default(autoincrement())
  analysisId         Int
  gapsData           String?  @db.Text
  centroidsData      String?  @db.Text
  zonalStatsData     Json?
  globalStatsData    Json?
  topologyReportData Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model GeoprocessingOp {
  id           Int         @id @default(autoincrement())
  analysisId   Int
  opType       OpType
  params       Json?
  result       Json?
  status       OpStatus    @default(SUCCESS)
  errorMessage String?     @db.Text
  durationMs   Int         @default(0)
  createdAt    DateTime    @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

enum OpType {
  BUFFER
  UNION
  SIMPLIFY
  ZONAL_STATS
  AUTO_CORRECT
  CENTROIDS
  VALIDATE
  EXPORT_ZIP
}

enum OpStatus {
  SUCCESS
  ERROR
}

model AiConversation {
  id         Int      @id @default(autoincrement())
  analysisId Int?
  userId     String?
  role       ChatRole
  content    String   @db.Text
  context    Json?
  createdAt  DateTime @default(now())

  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id])
}

enum ChatRole {
  USER
  ASSISTANT
}

// Parcelles cadastrales issues d'un import DXF Microstation (lotissement).
// La colonne `geom` (geometry(MultiPolygon, 32628)) est gérée hors-Prisma
// (Unsupported) : lecture/écriture via SQL brut, cf. parcelle-repository.ts
// et la migration add_parcelles.
model Parcelle {
  id               Int      @id @default(autoincrement())
  numero           String?
  denomination     String?
  autresTextes     Json?
  surfaceM2        Decimal  @db.Decimal(20, 4)
  geomGeoJson4326  Json
  geomHash         String
  sourceFichier    String
  epsg             String   @default("32628")
  dateImport       DateTime @default(now())
  geom             Unsupported("geometry(MultiPolygon, 32628)")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([numero, sourceFichier], name: "parcelle_numero_source_unique")
  @@unique([geomHash, sourceFichier], name: "parcelle_geomhash_source_unique")
}

// ───────────────────────────────────────────────────────────────────────────
// MODULE CADASTRE (VERICAD) — gestion des NICAD (Syscol 2013 → 2026)
//
// Porté depuis l'app vericad (Drizzle/MySQL). Toutes les tables sont préfixées
// `cad_` et les modèles `Cad*` pour ne pas entrer en collision avec le cœur
// geoaino (qui possède déjà un `model Parcelle` pour l'import DXF).
//
// Les champs `version`/`statut`/`typeOperation` sont des `String` (valeurs
// "2013"/"2026", "actif", …) pour rester fidèles à la logique métier portée.
// Les colonnes `geom` PostGIS sont `Unsupported` (lecture/écriture via SQL brut,
// cf. src/lib/cadastre/data.ts), comme le `model Parcelle` existant.
// ───────────────────────────────────────────────────────────────────────────

// Communes — ancien système Syscol 2013
model CadCommune2013 {
  id           Int      @id @default(autoincrement())
  nomCommune   String
  syscol       String
  syscolPadded String // 8 chiffres avec zéros devant
  region       String?
  departement  String?
  cav          String?
  superficie   Decimal? @db.Decimal(15, 6)
  geojson      String?  @db.Text
  geom         Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt    DateTime @default(now())

  @@index([syscolPadded])
  @@map("cad_communes_2013")
}

// Communes — nouveau système Syscol 2026
model CadCommune2026 {
  id            Int      @id @default(autoincrement())
  nomCommune    String
  region        String?
  departement   String?
  cav           String?
  arrondissement String?
  codSyscol     String
  syscolPadded  String // 8 chiffres avec zéros devant
  geojson       String?  @db.Text
  geom          Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt     DateTime @default(now())

  @@index([syscolPadded])
  @@map("cad_communes_2026")
}

// Sections cadastrales (une section ∈ une commune)
model CadSection {
  id            Int      @id @default(autoincrement())
  syscolCommune String // syscolPadded de la commune
  version       String // "2013" | "2026"
  numSection    String // 3 chiffres padded
  nomSection    String?
  nomCommune    String?
  region        String?
  departement   String?
  geojson       String?  @db.Text
  geom          Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt     DateTime @default(now())
  createdBy     String?

  @@index([syscolCommune, numSection, version])
  @@map("cad_sections")
}

// Parcelles cadastrales (une parcelle ∈ une section ∈ une commune)
model CadParcelle {
  id            Int      @id @default(autoincrement())
  syscolCommune String // syscolPadded
  numSection    String // 3 chiffres padded
  numParcelle   String // 5 chiffres padded
  version       String // "2013" | "2026"
  nicad         String? // 16 caractères (null si pas encore généré)
  statut        String   @default("sans_nicad") // sans_nicad | actif | bascule | invalide
  nomProprietaire String?
  superficie    Decimal? @db.Decimal(12, 4)
  longitude     Decimal? @db.Decimal(15, 8)
  latitude      Decimal? @db.Decimal(15, 8)
  geojson       String?  @db.Text
  geom          Unsupported("geometry(MultiPolygon, 4326)")?
  nomCommune    String?
  region        String?
  departement   String?
  numLot        String?
  titreParce    String?
  typeDocFon    String?
  natJuri       String?
  typeDestin    String?
  catOcup       String?
  quartier      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  @@index([syscolCommune, numSection, version])
  @@index([nicad])
  @@map("cad_parcelles")
}

// Job de traitement asynchrone d'un fichier CAO Microstation (DXF/DGN).
// Domaine « traitement de données Microstation » (cœur geoaino), PAS le module
// verifcad : le job rejoue le pipeline d'ingestion + analyse topologique et
// produit une `Analysis` (consultable sur /map/[analysisId]). Exécuté après la
// réponse HTTP — la requête d'upload retourne immédiatement un `id` et
// l'interface sonde l'avancement. cf. src/lib/import/run-job.ts.
model ImportJob {
  id         Int      @id @default(autoincrement())
  fileName   String
  fileKey    String // chemin du fichier source persisté (préfixe local:)
  sourceType String // DXF | DGN
  status     String   @default("pending") // pending | running | completed | failed
  phase      String? // read | build | nicad | analyze | done
  progress   Int      @default(0) // 0..100
  totalBuilt Int      @default(0) // parcelles construites par l'ingestion
  analysisId Int? // Analysis produite (navigation /map/[analysisId])
  report     Json? // rapport d'ingestion + stats d'analyse (errorCount, score…)
  layerMapping Json? // mappage calque → classe DGID validé par l'utilisateur (variante « simple »)
  // Cible du job : "parcelles" (défaut, produit une Analysis) ou "sections"
  // (produit les lignes limite_section + contrôle des chevauchements).
  kind       String   @default("parcelles")
  error      String?  @db.Text
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@map("import_jobs")
}

// ───────────────────────────────────────────────────────────────────────────
// LIMITES DE SECTION (issues des DXF) — table de référence + contrôle topologie
//
// Construite à partir de la couche `limites_sections` d'un DXF (polygones) et des
// libellés `numero_section` (cf. src/lib/parcelle-ingestion.ts + build-sections.ts).
// La commune / région / département sont résolues par jointure spatiale sur
// `cad_communes_2026`. La colonne `geom` PostGIS est `Unsupported` (lecture/écriture
// SQL brut, comme `Parcelle`/`Cad*`).
// ───────────────────────────────────────────────────────────────────────────
model LimiteSection {
  id            Int      @id @default(autoincrement())
  region        String?
  departement   String?
  commune       String?
  syscolCommune String? // syscolPadded 2026 de la commune contenante (jointure spatiale)
  numSection    String?
  surfaceM2     Decimal? @db.Decimal(20, 4)
  geomGeoJson   Json // géométrie 4326 (rendu client sans PostGIS)
  geom          Unsupported("geometry(MultiPolygon, 4326)")?
  sourceFichier String // regroupe un lot d'import
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sourceFichier])
  @@index([syscolCommune, numSection])
  @@map("limite_section")
}

// Chevauchements détectés entre deux limite_section (contrôle topologique).
// Calqué sur OverlapGeometry ; `status` suit la résolution par l'utilisateur.
model LimiteSectionOverlap {
  id                Int      @id @default(autoincrement())
  sourceFichier     String
  sectionAId        Int
  sectionBId        Int
  intersectionGeoJson Json
  overlapAreaM2     Decimal? @db.Decimal(20, 4)
  status            String   @default("PENDING") // PENDING | RESOLVED | IGNORED
  createdAt         DateTime @default(now())

  @@index([sourceFichier, status])
  @@map("limite_section_overlap")
}

// Historique des modifications sections/parcelles — une entrée par action
// utilisateur (pas par ligne modifiée), avec un snapshot avant/après complet
// pour permettre de restaurer n'importe quel point passé, pas seulement la
// dernière action. `scope` distingue les surfaces qui l'alimentent (sections
// QA vs analyses /map) dans une table unique, pour un panneau et une route de
// restauration communs. Cf. docs/superpowers/specs/2026-08-06-cadastre-history-restore-design.md.
model CadHistoryEntry {
  id         Int       @id @default(autoincrement())
  scope      String // "sections" | "map"
  scopeKey   String? // syscolCommune (sections, meilleur effort) | analysisId (map)
  action     String // "delete" | "numero" | "correct" | "correct-batch" | "merge" | "nicad-fill" | "map-delete" | "map-rename" | "restore"
  summary    String
  before     Json
  after      Json
  restoredAt DateTime?
  restoredBy String?
  createdAt  DateTime  @default(now())
  createdBy  String?

  @@index([scope, scopeKey, createdAt])
  @@map("cad_history_entries")
}

// Registre principal des NICAD
model CadNicad {
  id          Int      @id @default(autoincrement())
  nicad       String   @unique
  syscol      String
  section     String   @default("001")
  numParcelle String
  version     String // "2013" | "2026"
  statut      String   @default("actif") // actif | bascule | invalide
  nomCommune  String?
  region      String?
  departement String?
  longitude   Decimal? @db.Decimal(15, 8)
  latitude    Decimal? @db.Decimal(15, 8)
  nicadNouveau String? // NICAD 2026 si basculé
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  @@index([version])
  @@index([statut])
  @@map("cad_nicads")
}

// Historique des basculements NICAD
model CadNicadHistorique {
  id              Int      @id @default(autoincrement())
  nicadAncien     String
  nicadNouveau    String
  syscolAncien    String
  syscolNouveau   String
  sectionAncienne String?
  sectionNouvelle String?
  communeAncienne String?
  communeNouvelle String?
  motif           String?  @db.Text
  operationId     Int?
  createdAt       DateTime @default(now())
  createdBy       String?

  @@map("cad_nicad_historique")
}

// Journal des opérations
model CadOperationLog {
  id            Int      @id @default(autoincrement())
  typeOperation String // verification | generation | basculement | import | export
  statut        String   @default("en_cours") // succes | echec | en_cours
  description   String?  @db.Text
  nbTraites     Int      @default(0)
  nbSucces      Int      @default(0)
  nbEchecs      Int      @default(0)
  details       Json?
  fichierSource String?
  fichierResultat String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  @@index([typeOperation])
  @@map("cad_operations_log")
}

// Correspondance Syscol 2013 → 2026
model CadCorrespondance {
  id             Int      @id @default(autoincrement())
  syscol2013     String // 8 chiffres
  nomCommune2013 String
  syscol2026     String?
  nomCommune2026 String?
  region         String?
  departement    String?
  departement2026 String? // département dans le référentiel 2026 (détection rattachement)
  statut         String   @default("provisoire") // confirme | provisoire | sans_correspondance
  // inchange | renomme | rattachement_departement | decoupe | fusion | disparue
  typeChangement String?
  nbCibles2026   Int      @default(0) // nb de communes 2026 issues (≥ seuil) → découpage si ≥ 2
  nbSources2013  Int      @default(0) // nb de communes 2013 visant la même 2026 → fusion si ≥ 2
  cibles2026     String?  @db.Text // liste "syscol:nom (recouvr%)" des communes 2026 liées
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?

  @@index([syscol2013])
  @@map("cad_correspondance_2013_2026")
}

// Fichiers importés
model CadFichierImporte {
  id          Int      @id @default(autoincrement())
  nomFichier  String
  typeFichier String // parcelles | sections | communes | autre
  version     String // "2013" | "2026"
  urlS3       String?
  nbEntites   Int      @default(0)
  statut      String   @default("en_attente") // en_attente | traite | erreur
  erreur      String?  @db.Text
  createdAt   DateTime @default(now())
  createdBy   String?

  @@map("cad_fichiers_importes")
}
