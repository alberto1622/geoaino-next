# .env.example — modèle de configuration. Copier en `.env` puis remplacer les
# valeurs. Ne JAMAIS committer `.env` (il contient des secrets).
# Les valeurs ci-dessous sont des exemples, pas des secrets réels.

# ─── Secrets (privés, serveur uniquement) ────────────────────────────────────

# Base PostgreSQL/PostGIS (Prisma)
DATABASE_URL="postgresql://postgres:CHANGER_MOI@localhost:5432/geoaino_supreme"

# Signature des sessions NextAuth — chaîne aléatoire de 32 caractères minimum
# (ex. `openssl rand -base64 32`). Changer ce secret invalide toutes les sessions.
NEXTAUTH_SECRET="CHANGER_MOI"
NEXTAUTH_URL="http://localhost:3000"

# Assistant IA (au moins une des deux clés ; OpenAI prioritaire si présente)
OPENAI_API_KEY=""
GROQ_API_KEY=""

# docker-compose (Postgres / pgAdmin) — POSTGRES_PASSWORD est obligatoire
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGER_MOI"
POSTGRES_DB="geoaino_supreme"
PGADMIN_DEFAULT_EMAIL="admin@example.com"
PGADMIN_DEFAULT_PASSWORD="CHANGER_MOI"

# Migration ponctuelle depuis VERICAD (scripts/migrate-vericad.ts uniquement)
# VERICAD_MYSQL_URL="mysql://user:CHANGER_MOI@localhost:3306/vericad"

# ─── Configuration publique (exposée au navigateur, jamais de secret ici) ────

# Port du serveur de tuiles vectorielles
# NEXT_PUBLIC_TILES_PORT="3001"

# ─── Réglages optionnels (valeurs par défaut dans le code) ──────────────────

# Taille max d'un envoi et d'une archive ZIP décompressée (Mo)
# MAX_UPLOAD_MB="500"
# MAX_UNZIPPED_MB="1500"

# Dossiers de stockage (par défaut : dossier utilisateur de l'application)
# GEOAINO_DATA_DIR=""
# IMPORT_UPLOADS_DIR=""
# LOCAL_GEOJSON_DIR=""

# Conversion DGN → DXF par un outil externe (ex. ODA File Converter)
# DGN_TO_DXF_BIN=""
# DGN_TO_DXF_ARGS=""

# Les seuils de traitement DXF (DXF_*, SECTION_*) sont documentés dans
# docs/CONCEPTS-TRAITEMENT-DXF.md.
